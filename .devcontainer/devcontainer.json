{
  "name": "mpicbg",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/New_York}",
      //      "CLAUDE_CODE_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.19.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.1"
    }
  },
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "Anthropic.claude-code",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-docker",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow",
        "ms-python.vscode-pylance",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.vscode-python-envs",
        "mechatroner.rainbow-csv",
        "vscjava.vscode-java-pack"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        },
        "python.defaultInterpreterPath": "/home/node/venv/bin/python",
        "terminal.integrated.gpuAcceleration": "off"
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=${localEnv:HOME}/.Xauthority-devcontainer,target=/home/node/.Xauthority,type=bind,readonly"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "TZ": "America/New_York",
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/home/node/.Xauthority"
  },
  "remoteEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "PATH": "/home/node/.local/bin:/home/node/venv/bin:${containerEnv:PATH}",
    "VIRTUAL_ENV": "/home/node/venv",
    "TZ": "America/New_York",
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/home/node/.Xauthority"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "initializeCommand": "if [ -n \"$XAUTHORITY\" ] && [ -f \"$XAUTHORITY\" ]; then cp -f \"$XAUTHORITY\" \"$HOME/.Xauthority-devcontainer\" && chmod 600 \"$HOME/.Xauthority-devcontainer\"; else touch \"$HOME/.Xauthority-devcontainer\"; fi;",
  "postCreateCommand": "sudo /usr/local/bin/init-firewall.sh",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh"
}
